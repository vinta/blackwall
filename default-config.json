{
  "network": {
    "allowedDomains": ["*"],
    "deniedDomains": []
  },
  "enableWeakerNetworkIsolation": true,
  "allowPty": true,
  "filesystem": {
    "denyRead": ["~/", "/private/var/folders", "/Volumes"],
    "allowRead": [
      "~/.local/bin",
      "~/.local/share",
      "~/.local/state",
      "~/.gitconfig",
      "~/.gitignore_global",
      "~/.config/uv/uv.toml"
    ],
    "allowWrite": [],
    "denyWrite": []
  }
}
