{
  "network": {
    "allowedDomains": ["*"],
    "deniedDomains": []
  },
  "enableWeakerNetworkIsolation": true,
  "allowPty": true,
  "filesystem": {
    "denyRead": ["/"],
    "allowRead": [
      "/System",
      "/usr/bin",
      "/usr/lib",
      "/usr/libexec",
      "/usr/sbin",
      "/usr/share",
      "/bin",
      "/sbin",
      "/private/etc",
      "/etc",
      "/private/var/run",
      "/private/var/select",
      "/private/var/db/timezone",
      "/var",
      "/dev",
      "/opt/homebrew",
      "/private/tmp",
      "/tmp",
      "/Library/Developer/CommandLineTools",
      "~/.local/bin",
      "~/.local/share",
      "~/.local/state",
      "~/.gitconfig",
      "~/.gitignore_global",
      "~/.config/uv/uv.toml"
    ],
    "allowWrite": [],
    "denyWrite": []
  }
}
