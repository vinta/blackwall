{
  "presets": [
    "python",
    "npm",
    "github"
  ],
  "network": {
    "allowedDomains": [],
    "deniedDomains": []
  },
  "enableWeakerNetworkIsolation": true,
  "enableWeakerNestedSandbox": false,
  "allowPty": true,
  "filesystem": {
    "denyRead": [
      "/"
    ],
    "allowRead": [
      "/bin",
      "/dev",
      "/etc",
      "/sbin",
      "/usr/bin",
      "/usr/lib",
      "/usr/libexec",
      "/usr/sbin",
      "/usr/share",
      "/var",
      "~/.config/git/ignore",
      "~/.config/uv/uv.toml",
      "~/.gitconfig",
      "~/.gitignore_global",
      "~/.local/bin",
      "~/.local/share",
      "~/.local/state"
    ],
    "allowWrite": [],
    "denyWrite": []
  }
}
