{
  "presets": [
    "agent-files",
    "python",
    "node",
    "github",
    "git",
    "pre-commit",
    "local-network",
    "private-network"
  ],
  "network": {
    "allowedHosts": [],
    "deniedHosts": []
  },
  "filesystem": {
    "denyRead": [
      "/"
    ],
    "allowRead": [
      "/bin",
      "/dev",
      "/etc",
      "/sbin",
      "/usr/bin",
      "/usr/lib",
      "/usr/libexec",
      "/usr/sbin",
      "/usr/share",
      "/var",
      "~/.local/bin"
    ],
    "allowWrite": [],
    "denyWrite": []
  },
  "srt": {
    "enableWeakerNetworkIsolation": true,
    "enableWeakerNestedSandbox": false,
    "allowNestedUserNamespaces": false,
    "allowPty": true
  }
}
