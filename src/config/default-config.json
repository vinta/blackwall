{
  "presets": [
    "python",
    "node",
    "github",
    "git",
    "pre-commit"
  ],
  "network": {
    "allowedDomains": [],
    "deniedDomains": []
  },
  "enableWeakerNetworkIsolation": true,
  "enableWeakerNestedSandbox": false,
  "allowPty": true,
  "filesystem": {
    "denyRead": [
      "/"
    ],
    "allowRead": [
      "/bin",
      "/dev",
      "/etc",
      "/sbin",
      "/usr/bin",
      "/usr/lib",
      "/usr/libexec",
      "/usr/sbin",
      "/usr/share",
      "/var",
      "~/.local/bin"
    ],
    "allowWrite": [],
    "denyWrite": []
  }
}
