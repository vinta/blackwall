#compdef blackwall

# Same shape as zsh's own _sudo: blackwall's flags, then the command, whose own completion takes over
local exclusive='(--print-config --print-file-access --print-network-access --print-env --trust --version --completion)'

# _arguments hands the command's completion no words after a leading --, so drop it as _env drops its -
if [[ $words[2] == -- ]] && (( CURRENT > 2 )); then
  words[2]=()
  (( CURRENT-- ))
fi

_arguments -S -A '-*' \
  '*--add-dir[also let the command write to another folder]:folder:_directories' \
  "${exclusive}--print-config[show the merged config]" \
  "${exclusive}--print-file-access[show what the command can read and write]" \
  "${exclusive}--print-network-access[show which hosts the command can reach]" \
  "${exclusive}--print-env[show the env vars blackwall adds, and why]" \
  '(- 1 *)--trust[trust .blackwall/config.json in the current folder]' \
  '(- 1 *)--version[show the blackwall version]' \
  '(- 1 *)--completion[print the shell completion script]:shell:(zsh)' \
  '(-)1:command:_command_names -e' \
  '*::arguments:_normal'
